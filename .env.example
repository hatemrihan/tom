# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — never prefix with NEXT_PUBLIC_. Needed for the contact form and /admin.
SUPABASE_SECRET_KEY=sb_secret_...

# Long random string used to sign in at /admin (e.g. `openssl rand -hex 32`)
ADMIN_SECRET_KEY=change-me

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
