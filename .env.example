# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (contacts + component settings)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
MONGODB_DB=tom_portfolio

# Long random string used to sign in at /admin (e.g. `openssl rand -hex 32`)
ADMIN_SECRET_KEY=change-me

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
